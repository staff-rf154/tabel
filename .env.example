# Проект
COMPOSE_PROJECT_NAME=tabel
APP_ENV=development

# Backend
BACKEND_PORT=8080
HTTP_PORT=8080

# Настройки приложения (SQLite на сервере приложений)
SETTINGS_DB_PATH=/data/settings.db
# 32-байтный ключ в hex (64 символа). Сгенерировать: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
# Разрешённые Origin для CORS (через запятую), * — все
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082
# JWT: если секрет не задан, он выводится из SETTINGS_ENCRYPTION_KEY
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# PostgreSQL
POSTGRES_USER=tabel
POSTGRES_PASSWORD=CHANGE_ME_postgres
POSTGRES_DB=tabel
POSTGRES_PORT=5432

# Пул подключений backend к PostgreSQL
DB_MAX_CONNS=40
DB_MIN_CONNS=4

# PgBouncer
PGBOUNCER_PORT=6432
PGBOUNCER_INTERNAL_PORT=5432
PGBOUNCER_HOST=pgbouncer
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_POOL_SIZE=40
PGBOUNCER_AUTH_TYPE=scram-sha-256

# Redis
REDIS_PASSWORD=CHANGE_ME_redis
REDIS_PORT=6379
REDIS_ADDR=redis:6379

# S3-хранилище (Garage)
S3_API_PORT=9000
GARAGE_ADMIN_PORT=9001
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=tabel
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=false
S3_PATH_STYLE=true

# SSL-сертификаты (каталог монтируется в /ssl)
SSL_DIR=/opt/ssl
SSL_CERT_PATH=/ssl/staff-rf/fullchain.pem
SSL_KEY_PATH=/ssl/staff-rf/privkey.pem
HTTPS_PORT=443

# Веб-панели
ADMIN_PORT=8081
OPERATOR_PORT=8082

# Строка подключения backend (через PgBouncer, внутри сети порт 5432)
DATABASE_URL=postgres://tabel:CHANGE_ME_postgres@pgbouncer:5432/tabel?sslmode=disable
# Прямое подключение к PostgreSQL — для pg_dump/pg_restore и миграций
DATABASE_DIRECT_URL=postgres://tabel:CHANGE_ME_postgres@postgres:5432/tabel?sslmode=disable
