// Схема БД «Табель» (PostgreSQL 16) — dbdiagram.io / dbml
// Источник истины: backend/internal/db/migrations/*.sql

Table employees {
  id uuid [pk]
  employee_number text [not null, unique]
  full_name text [not null]
  email text
  phone text
  position text
  is_active boolean [not null, default: true]
  hired_at date
  fired_at date
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table users {
  id uuid [pk]
  employee_id uuid [unique, ref: > employees.id]
  role text [not null]
  login text [not null, unique]
  password_hash text [not null]
  password_algo text [not null, default: 'argon2id']
  failed_attempts integer [not null, default: 0]
  is_locked boolean [not null, default: false]
  auth_blocked boolean [not null, default: false]
  is_main_admin boolean [not null, default: false]
  registration_reset_allowed boolean [not null, default: false]
  registered_at timestamptz
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table sessions {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  token_hash text [not null, unique]
  user_agent text
  ip inet
  expires_at timestamptz [not null]
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table schedules {
  id uuid [pk]
  employee_id uuid [not null, ref: > employees.id]
  pattern_type text [not null]
  workdays smallint[]
  start_time time [not null]
  end_time time [not null]
  valid_from date [not null]
  valid_to date
  is_active boolean [not null, default: true]
  source_file text
  created_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table shifts {
  id uuid [pk]
  employee_id uuid [not null, ref: > employees.id]
  schedule_id uuid [ref: > schedules.id]
  check_in_mark_id uuid
  check_out_mark_id uuid
  started_at timestamptz [not null]
  ended_at timestamptz
  status text [not null, default: 'open']
  overtime boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// Партиционирована по RANGE (timestamp_server), PK (id, timestamp_server)
Table marks {
  id uuid [not null]
  timestamp_server timestamptz [not null]
  employee_id uuid [not null, ref: > employees.id]
  operator_id uuid [ref: > users.id]
  operator_number text
  event_type text [not null]
  timestamp_client timestamptz
  lat double
  lon double
  accuracy_m double
  location_age_sec integer
  device_os text
  device_os_version text
  device_model text
  app_version text
  mock_location boolean [not null, default: false]
  outside_office boolean [not null, default: false]
  overtime boolean [not null, default: false]
  auto_closed_previous boolean [not null, default: false]
  qr_source text
  qr_data_mismatch boolean [not null, default: false]
  client_type text
  shift_id uuid [ref: > shifts.id]
  idempotency_key uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (id, timestamp_server) [pk]
  }
}

Table mark_idempotency {
  idempotency_key uuid [pk]
  mark_id uuid
  employee_id uuid
  created_at timestamptz [not null, default: `now()`]
}

Table qr_tokens {
  id uuid [pk]
  employee_id uuid [not null, ref: > employees.id]
  type text [not null]
  token uuid [not null, unique]
  payload jsonb [not null]
  signature text [not null]
  valid_from date
  valid_until date
  status text [not null, default: 'active']
  issued_by uuid [ref: > users.id]
  issued_at timestamptz [not null, default: `now()`]
  revoked_at timestamptz
  revoked_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table delegations {
  id uuid [pk]
  from_user_id uuid [not null, ref: > users.id]
  to_user_id uuid [not null, ref: > users.id]
  status text [not null, default: 'pending']
  requested_at timestamptz [not null, default: `now()`]
  valid_until timestamptz [not null]
  decided_by uuid [ref: > users.id]
  decided_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table notifications {
  id uuid [pk]
  type text [not null]
  title text [not null]
  body text
  payload jsonb
  target_user_id uuid [ref: > users.id]
  is_read boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
}

Table audit_log {
  id bigserial [pk]
  actor_user_id uuid [ref: > users.id]
  action text [not null]
  entity_type text
  entity_id text
  details jsonb
  ip inet
  user_agent text
  created_at timestamptz [not null, default: `now()`]
}

Table oauth_clients {
  id uuid [pk]
  client_id text [not null, unique]
  client_secret_hash text [not null]
  name text
  is_active boolean [not null, default: true]
  secret_rotated_at timestamptz
  next_rotation_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table oauth_access_tokens {
  id uuid [pk]
  client_id text [not null]
  token_hash text [not null, unique]
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table ip_whitelist {
  id uuid [pk]
  oauth_client_id uuid [ref: > oauth_clients.id]
  cidr cidr [not null]
  description text
  created_at timestamptz [not null, default: `now()`]
}

Table export_acks {
  mark_id uuid [pk]
  client_id text
  acked_at timestamptz [not null, default: `now()`]
}

Table offline_imports {
  id uuid [pk]
  uploaded_by uuid [ref: > users.id]
  filename text [not null]
  rows_total integer [not null, default: 0]
  rows_ok integer [not null, default: 0]
  rows_error integer [not null, default: 0]
  status text [not null]
  report jsonb
  created_at timestamptz [not null, default: `now()`]
}

Table offices {
  id uuid [pk]
  name text [not null]
  lat double [not null]
  lon double [not null]
  radius_m integer [not null, default: 500]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}
